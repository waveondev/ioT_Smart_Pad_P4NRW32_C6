# 5. 백업 및 임시 폴더 제외
backup_*/
*backup*/
source_backup/
component_backups/

# 6. sdkconfig 변형 백업 파일 제외 (sdkconfig, sdkconfig.defaults만 허용)
sdkconfig.*
!sdkconfig.defaults

# 7. 빌드 산출물 및 자동 생성 컴포넌트 제외
build/
managed_components/

